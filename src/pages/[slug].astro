---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mermaid from '../components/Mermaid.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { url, getPosts, formatDate, readingTime } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <header>
      <a class="back" href={url('/')}>← All writing</a>
      <h1>{post.data.title}</h1>
      <p class="eyebrow">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        {readingTime(post.body)} min read
      </p>
    </header>

    <TableOfContents headings={headings} />

    <div class="prose">
      <Content />
    </div>
  </article>
  <Mermaid />
</Base>

<script>
  // Copy-to-clipboard buttons on code blocks
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy';
    button.textContent = 'Copy';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1500);
    });
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.replaceWith(wrapper);
    wrapper.append(pre, button);
  }
</script>

<style>
  header {
    margin-bottom: 3rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    text-decoration: none;
    transition: color 0.2s, transform 0.2s;
  }
  .back:hover {
    color: var(--accent);
    transform: translateX(-3px);
  }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .eyebrow {
    display: flex;
    gap: 0.6rem;
    margin: 0;
  }

  .prose :global(.code-block) {
    position: relative;
  }
  .prose :global(.copy) {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, color 0.2s;
  }
  .prose :global(.code-block:hover .copy),
  .prose :global(.copy:focus-visible) {
    opacity: 1;
  }
  .prose :global(.copy:hover) {
    color: var(--text);
  }
  @media (hover: none) {
    .prose :global(.copy) {
      opacity: 1;
    }
  }
</style>
